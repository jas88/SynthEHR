<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
    <!-- Enable Microsoft.Testing.Platform with NUnit runner -->
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- CA1707: underscores in test method names are conventional and aid readability.
         CA1861: inline constant arrays are test data, kept next to the assertions that use them.
         IL2026/IL2067/IL2075: tests use reflection (e.g. GetExportedTypes, generated data classes) to
         cross-check the AOT-clean production code; the test project is never trimmed, so trim warnings
         do not apply. -->
    <NoWarn>$(NoWarn);CA1707;CA1861;IL2026;IL2067;IL2075</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source CSVs, re-read by GeneratedDataRoundTripTests to check the generated data classes -->
    <None Include="..\data\*.csv" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The CodeQL build (DISABLE_SOURCE_GENERATOR=true) replaces the generated data classes with internal
         stubs (SynthEHR.Core/Data/CodeQLStubs.cs), so these tests cannot compile there. Tests only run on the
         normal build. -->
    <Compile Remove="GeneratedDataRoundTripTests.cs" Condition="'$(DISABLE_SOURCE_GENERATOR)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drives CsvDataSourceGenerator directly in CsvDataSourceGeneratorTests -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SynthEHR.Core\SynthEHR.Core.csproj" />
    <ProjectReference Include="..\SynthEHR.SourceGenerators\SynthEHR.SourceGenerators.csproj" />
  </ItemGroup>

  <!-- Exclude CodeCoverage - conflicts with NUnit on .NET 10 -->
  <ItemGroup>
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
