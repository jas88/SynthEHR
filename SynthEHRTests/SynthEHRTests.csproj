<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
    <!-- Enable Microsoft.Testing.Platform with NUnit runner -->
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- CA1707: underscores in test method names are conventional and aid readability.
         IL2026/IL2067: tests use reflection (e.g. GetExportedTypes) to cross-check the AOT-clean
         production code; the test project is never trimmed, so trim warnings do not apply. -->
    <NoWarn>$(NoWarn);CA1707;IL2026;IL2067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SynthEHR.Core\SynthEHR.Core.csproj" />
  </ItemGroup>

  <!-- Exclude CodeCoverage - conflicts with NUnit on .NET 10 -->
  <ItemGroup>
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
