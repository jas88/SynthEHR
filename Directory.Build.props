<Project>
  <!--
    SynthEHR Build Configuration
    Imports shared build standards from the build-standards submodule

    SynthEHR is an executable repository (contains SynthEHR.exe),
    so it uses the executable-repo pattern for target framework selection.
  -->

  <!-- Import executable repo pattern for target framework selection -->
  <Import Project="build-standards/Directory.Build.props.executable-repo" />

  <!-- Import shared build standards -->
  <Import Project="build-standards/Directory.Build.props.shared" />

  <!--
    Target Framework Configuration
    Auto-generated by scripts/generate-build-props.sh based on SDK version
    - Libraries: multi-target all non-EOL .NET versions
    - Tests (*Tests) and Executables (OutputType=Exe): latest only
    - Source generators (netstandard2.0): excluded from this logic
  -->
  <!-- @FRAMEWORKS_START@ -->
  <PropertyGroup Condition="!$(MSBuildProjectName.Contains('SourceGenerator')) AND !$(MSBuildProjectName.EndsWith('Tests')) AND '$(OutputType)' != 'Exe'">
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="!$(MSBuildProjectName.Contains('SourceGenerator')) AND ($(MSBuildProjectName.EndsWith('Tests')) OR '$(OutputType)' == 'Exe')">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <!-- @FRAMEWORKS_END@ -->

  <!-- SynthEHR-specific overrides -->
  <PropertyGroup>
    <!-- Use GPL license instead of MIT -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <!-- Use latest C# instead of fixed 13.0 -->
    <LangVersion>latest</LangVersion>

    <!-- Use SharedAssemblyInfo.cs for versioning, not MinVer -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Project-specific metadata -->
    <RepositoryUrl>https://github.com/jas88/SynthEHR</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jas88/SynthEHR</PackageProjectUrl>
    <Authors>Health Informatics Centre - University of Dundee</Authors>

    <!-- Don't treat warnings as errors until code quality issues are fixed -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Don't include MinVer package since we use SharedAssemblyInfo.cs -->
  <ItemGroup>
    <PackageReference Remove="MinVer" />
  </ItemGroup>
</Project>
